    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "webstore-logs"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "aov_usd"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Avg Order Value ($)"
              },
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "checkouts"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Checkouts"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "algorithm"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Recommendation Variant"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 5,
      "interval": "30s",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "webstore-logs"
          },
          "query": "source=otel-logs-* | where body = \"checkout.completed\" AND `observedTimestamp` > DATE_SUB(NOW(), INTERVAL 10 MINUTE) | eval user_id = `attributes.app.user.id`, order_amount = `attributes.app.order.amount` | where isnotnull(user_id) | JOIN left=c right=r ON c.user_id = r.user_id [source=otel-logs-* | where body = \"recommendation served\" AND `observedTimestamp` > DATE_SUB(NOW(), INTERVAL 10 MINUTE) | dedup `attributes.app.user.id` | fields `attributes.app.user.id`, `attributes.app.recommendation.algorithm` | rename `attributes.app.user.id` as user_id, `attributes.app.recommendation.algorithm` as algorithm] | stats count() as checkouts, avg(order_amount) as aov by algorithm | eval aov_usd = round(aov, 2) | fields algorithm, checkouts, aov_usd | sort - checkouts",
          "queryType": "PPL",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "AOV by Recommendation Variant \u2014 correlated via session ID",
      "description": "Checkout logs joined with recommendation logs on app.user.id using OpenSearch PPL.",
      "type": "table"
    }
