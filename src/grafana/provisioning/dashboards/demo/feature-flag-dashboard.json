      "id": 10,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<h2>Demo 1 \u2014 Product Catalog Progressive Rollout (<code>productCatalogCanary</code>)</h2>\n<b>Safe canary release \u2014 observable regression, instant rollback.</b> Use flagd-ui to step from 5% \u2192 25% \u2192 50% and watch errors + latency appear. Roll back and watch recovery.",
        "mode": "html"
      },
      "type": "text",
      "title": ""
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "req/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*v1.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*v2.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (app_catalog_version) (rate(traces_span_metrics_calls_total{service_name=\"product-catalog\", app_catalog_version=~\"v1|v2\"}[30s]))",
          "legendFormat": "{{app_catalog_version}}",
          "refId": "A",
          "interval": "5s"
        }
      ],
      "title": "Canary Traffic Split (v1 / v2)",
      "description": "Step up v2 rollout in flagd-ui and watch the split change.",
      "type": "timeseries",
      "interval": "5s"
    },
    {
