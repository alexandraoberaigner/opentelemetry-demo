          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<h2>Demo 3 \u2014 Recommendation A/B Test (<code>recommendationAlgorithm</code>)</h2>\n<b>Is the new model actually making money?</b> \u2014 Per-variant distribution, p95 latency, checkout rate, AOV correlated via session ID.",
        "mode": "html"
      },
      "type": "text",
      "title": ""
    },
    {
      "datasource": {
        "type": "prometheus",
