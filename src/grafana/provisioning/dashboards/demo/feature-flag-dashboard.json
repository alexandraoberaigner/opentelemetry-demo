{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "<h2>Feature Flag Observability — Recommendation A/B Test</h2>\n<b>Is the new model actually making money?</b> — Variant distribution, p95 latency, checkout rate, and per-variant AOV.\n<br/>Per-variant AOV correlated via <code>app.user.id</code> (session ID) across recommendation and checkout logs in OpenSearch PPL.",
        "mode": "html"
      },
      "type": "text",
      "title": ""
    },
    {
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "axisLabel": "req/s", "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "auto", "stacking": { "mode": "normal" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 3 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "expr": "sum by (feature_flag_variant) (rate(traces_span_metrics_calls_total{service_name=\"recommendation\", feature_flag_key=\"recommendationAlgorithm\"}[$__rate_interval]))",
          "legendFormat": "{{feature_flag_variant}}",
          "refId": "A"
        }
      ],
      "title": "Recommendation Impressions by Variant",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "axisLabel": "latency", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto" },
          "unit": "ms", "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 3 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "expr": "histogram_quantile(0.95, sum by (le, feature_flag_variant) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"recommendation\", feature_flag_key=\"recommendationAlgorithm\"}[$__rate_interval])))",
          "legendFormat": "p95 — {{feature_flag_variant}}",
          "refId": "A"
        }
      ],
      "title": "p95 Latency by Variant",
      "description": "The personalized model adds inference latency. Is the business lift worth the performance cost?",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "custom": { "axisBorderShow": false, "axisLabel": "checkouts/s", "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "auto" },
          "unit": "reqps", "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 3 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "webstore-metrics" },
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"frontend\", span_name=\"oteldemo.CheckoutService/PlaceOrder\"}[$__rate_interval]))",
          "legendFormat": "checkouts/s",
          "refId": "A"
        }
      ],
      "title": "Checkout Rate",
      "description": "Shift the variant in flagd-ui and watch this respond.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "webstore-logs" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "aov_usd" },
            "properties": [
              { "id": "displayName", "value": "Avg Order Value ($)" },
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "checkouts" },
            "properties": [
              { "id": "displayName", "value": "Checkouts" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "algorithm" },
            "properties": [
              { "id": "displayName", "value": "Recommendation Variant" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 5,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "webstore-logs" },
          "query": "source=otel-logs-* | where body = \"order placed\" AND `observedTimestamp` > DATE_SUB(NOW(), INTERVAL 15 MINUTE) | eval user_id = `attributes.app.user.id`, order_amount = `attributes.app.order.amount` | where isnotnull(user_id) | JOIN left=c right=r ON c.user_id = r.user_id [source=otel-logs-* | where body = \"recommendation served\" AND `observedTimestamp` > DATE_SUB(NOW(), INTERVAL 15 MINUTE) | dedup `attributes.app.user.id` | fields `attributes.app.user.id`, `attributes.app.recommendation.algorithm` | rename `attributes.app.user.id` as user_id, `attributes.app.recommendation.algorithm` as algorithm] | stats count() as checkouts, avg(order_amount) as aov by algorithm | eval aov_usd = round(aov / 100, 2) | fields algorithm, checkouts, aov_usd | sort - checkouts",
          "queryType": "PPL",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "AOV by Recommendation Variant — correlated via session ID",
      "description": "Checkout logs joined with recommendation logs on app.user.id using OpenSearch PPL. Variant originates from the OpenFeature TracingHook span event.",
      "type": "table"
    }
  ],
  "schemaVersion": 39,
  "tags": ["feature-flags", "openfeature", "recommendation"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Feature Flag — Recommendation A/B Test",
  "uid": "feature-flag-recommendation",
  "version": 1
}
